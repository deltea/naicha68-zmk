&i2c1 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    ioex0: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
    };

    ioex1: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        poll-period-ms = <5>;

        col-gpios
            = <&ioex1  0 GPIO_ACTIVE_HIGH>  /* Col  0 → EXP1 P00 */
            , <&ioex1  1 GPIO_ACTIVE_HIGH>  /* Col  1 → EXP1 P01 */
            , <&ioex1  2 GPIO_ACTIVE_HIGH>  /* Col  2 → EXP1 P02 */
            , <&ioex1  3 GPIO_ACTIVE_HIGH>  /* Col  3 → EXP1 P03 */
            , <&ioex1  4 GPIO_ACTIVE_HIGH>  /* Col  4 → EXP1 P04 */
            , <&ioex1  5 GPIO_ACTIVE_HIGH>  /* Col  5 → EXP1 P05 */
            , <&ioex1  6 GPIO_ACTIVE_HIGH>  /* Col  6 → EXP1 P06 */
            , <&ioex1  7 GPIO_ACTIVE_HIGH>  /* Col  7 → EXP1 P07 */
            , <&ioex1  8 GPIO_ACTIVE_HIGH>  /* Col  8 → EXP1 P10 */
            , <&ioex1  9 GPIO_ACTIVE_HIGH>  /* Col  9 → EXP1 P11 */
            , <&ioex1 10 GPIO_ACTIVE_HIGH>  /* Col 10 → EXP1 P12 */
            , <&ioex1 11 GPIO_ACTIVE_HIGH>  /* Col 11 → EXP1 P13 */
            , <&ioex1 12 GPIO_ACTIVE_HIGH>  /* Col 12 → EXP1 P14 */
            , <&ioex1 13 GPIO_ACTIVE_HIGH>  /* Col 13 → EXP1 P15 */
            ;

        row-gpios
            = <&ioex0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 0 → EXP0 P00 */
            , <&ioex0 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 1 → EXP0 P01 */
            , <&ioex0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 2 → EXP0 P02 */
            , <&ioex0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 3 → EXP0 P03 */
            , <&ioex0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 4 → EXP0 P04 */
            ;
    };
};
