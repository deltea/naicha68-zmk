#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout_0 { // First physical layout, use different naming for other layouts
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>; // Label of the kscan node, optional if all layouts use the same
        transform = <&default_transform>; // Label of the matrix transform for this layout
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <5>; // Length of the "row-gpios" array
        columns = <17>; // Length of the "col-gpios" array
        map = <
        // Row 0: Cols 0..16
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16)
        // Row 1: Cols 0..16
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16)
        // Row 2: Cols 0..16
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16)
        // Row 3: Cols 0..16
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16)
        // Row 4: Cols 0..16
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16)
        >;
    };

    //  kscan_composite: kscan_composite {
    //      compatible = "zmk,kscan-composite";
    //      rows = <5>;
    //      columns = <17>;
    //
    //      matrix {
    //          kscan = <&kscan0>;
    //      };
    //  };

    kscan0: kscan_matrix {
        compatible = "zmk,kscan-matrix";
        wakeup-source;
        diode-direction = "col2row";

        /*
         * ROWS (0 to 4) mapped to Expander 1.
         * Using the last 5 pins of a 16-pin layout (pins 11 to 15).
         */
        row-gpios
            = <&pca9555_1 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 0 */
            , <&pca9555_1 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 1 */
            , <&pca9555_1 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 2 */
            , <&pca9555_1 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 3 */
            , <&pca9555_1 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 4 */
            ;

        /*
         * COLUMNS (0 to 16) mapped across both expanders.
         * Columns 0-10: Expander 1 (pins 10 down to 0).
         * Columns 11-16: Expander 2 (pins 5 down to 0).
         */
        col-gpios
            = <&pca9555_1  15 GPIO_ACTIVE_HIGH> /* Col 0  */
            , <&pca9555_1  14 GPIO_ACTIVE_HIGH> /* Col 1  */
            , <&pca9555_1  13 GPIO_ACTIVE_HIGH> /* Col 2  */
            , <&pca9555_1  12 GPIO_ACTIVE_HIGH> /* Col 3  */
            , <&pca9555_1  11 GPIO_ACTIVE_HIGH> /* Col 4  */
            , <&pca9555_1  10 GPIO_ACTIVE_HIGH> /* Col 5  */
            , <&pca9555_1  9 GPIO_ACTIVE_HIGH> /* Col 6  */
            , <&pca9555_1  8 GPIO_ACTIVE_HIGH> /* Col 7  */
            , <&pca9555_1  7 GPIO_ACTIVE_HIGH> /* Col 8  */
            , <&pca9555_1  6 GPIO_ACTIVE_HIGH> /* Col 9  */
            , <&pca9555_1  5 GPIO_ACTIVE_HIGH> /* Col 10 */
            , <&pca9555_2  20 GPIO_ACTIVE_HIGH> /* Col 11 */
            , <&pca9555_2  19 GPIO_ACTIVE_HIGH> /* Col 12 */
            , <&pca9555_2  18 GPIO_ACTIVE_HIGH> /* Col 13 */
            , <&pca9555_2  17 GPIO_ACTIVE_HIGH> /* Col 14 */
            , <&pca9555_2  16 GPIO_ACTIVE_HIGH> /* Col 15 */
            , <&pca9555_2  15 GPIO_ACTIVE_HIGH> /* Col 16 */
            ;
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    /* Your expander child nodes remain inside here */
    pca9555_1: pca9555@20 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
    };

    pca9555_2: pca9555@21 {
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
    };
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            /* Map TWIM signals to P0.04 (SDA) and P0.05 (SCL) */
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable; /* Saves battery when I2C is inactive */
        };
    };
};
