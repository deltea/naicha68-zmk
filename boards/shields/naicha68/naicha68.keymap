/*
 * ┌─────────────────────────────────────────────────────────────────────────┐
 * │  my_keyboard.keymap                                                     │
 * │  ZMK keymap for a 5-row × 14-column matrix (65 % ANSI template)        │
 * └─────────────────────────────────────────────────────────────────────────┘
 *
 * This file ships with a standard 65 % ANSI layout as a starting point.
 * Customize every binding to match your actual physical layout and matrix
 * wiring.
 *
 * Binding count per layer must exactly equal (rows × columns) = 5 × 14 = 70.
 * Use &trans for matrix positions that have no physical key (e.g. the extra
 * cells created by wide keys like Shift, Space, Backspace).
 *
 * Physical layout assumed (X = &trans / unused matrix cell):
 *
 *  C0    C1    C2    C3    C4    C5    C6    C7    C8    C9    C10   C11   C12   C13
 *  GRV   1     2     3     4     5     6     7     8     9     0     MINS  EQL   BSPC
 *  TAB   Q     W     E     R     T     Y     U     I     O     P     LBKT  RBKT  BSLH
 *  CAPS  A     S     D     F     G     H     J     K     L     SEMI  SQT   X     RET
 *  LSFT  X     Z     X     C     V     B     N     M     COMM  DOT   SLSH  RSFT  UP
 *  LCTL  LGUI  LALT  X     X     X     SPC   X     RALT  MO1   X     LEFT  DOWN  RGHT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ── Layer 0: Default ─────────────────────────────────────────────── */
        default_layer {
            label = "Base";
            /*
             * Each row is on its own comment line for readability.
             * Count = 14 + 14 + 14 + 14 + 14 = 70  ✓
             */
            bindings = <
                /* Row 0 ─ Number row */
                &kp GRAVE  &kp N1    &kp N2    &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8    &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC
                /* Row 1 ─ QWERTY */
                &kp TAB    &kp Q     &kp W     &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I     &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH
                /* Row 2 ─ Home row  (C12 is &trans: ENTER is wide) */
                &kp CLCK   &kp A     &kp S     &kp D    &kp F    &kp G    &kp H    &kp J    &kp K     &kp L    &kp SEMI  &kp SQT    &trans     &kp RET
                /* Row 3 ─ Shift row (C1 is &trans: LSHFT is wide) */
                &kp LSHFT  &trans    &kp Z     &kp X    &kp C    &kp V    &kp B    &kp N    &kp M     &kp COMMA &kp DOT  &kp FSLH   &kp RSHFT  &kp UP
                /* Row 4 ─ Bottom row (C3-C5, C7, C10 are &trans: SPACE is wide) */
                &kp LCTRL  &kp LGUI  &kp LALT  &trans   &trans   &trans   &kp SPACE &trans  &kp RALT  &mo 1    &trans    &kp LEFT   &kp DOWN   &kp RIGHT
            >;
        };

        /* ── Layer 1: Fn ──────────────────────────────────────────────────── */
        fn_layer {
            label = "Fn";
            bindings = <
                /* Row 0 ─ F-keys + Delete */
                &kp ESC    &kp F1    &kp F2    &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8    &kp F9   &kp F10   &kp F11    &kp F12    &kp DEL
                /* Row 1 ─ Bluetooth profile selection + clear */
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 2 ─ (reserved for future bindings) */
                &trans     &trans    &trans    &trans   &trans   &trans   &trans   &trans   &trans    &trans   &trans    &trans     &trans     &trans
                /* Row 3 ─ Page Up on arrow cluster */
                &trans     &trans    &trans    &trans   &trans   &trans   &trans   &trans   &trans    &trans   &trans    &trans     &trans     &kp PG_UP
                /* Row 4 ─ Home / Page Down / End on arrow cluster */
                &trans     &trans    &trans    &trans   &trans   &trans   &trans   &trans   &trans    &trans   &trans    &kp HOME   &kp PG_DN  &kp END
            >;
        };
    };
};
