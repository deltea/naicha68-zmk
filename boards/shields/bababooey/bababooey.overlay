&i2c1 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    ioex0: pca9555@20 {
        status = "okay";
        compatible = "nxp,pca9555";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
    };

    ioex1: pca9555@21 {
        status = "okay";
        compatible = "nxp,pca9555";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
    };
};

&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        poll-period-ms = <5>;

        col-gpios
            = <&ioex0 21 GPIO_ACTIVE_HIGH> // col 0
            , <&ioex0 20 GPIO_ACTIVE_HIGH> // col 1
            , <&ioex0 19 GPIO_ACTIVE_HIGH> // col 2
            , <&ioex0 18 GPIO_ACTIVE_HIGH> // col 3
            , <&ioex0 15 GPIO_ACTIVE_HIGH> // col 4
            , <&ioex0 14 GPIO_ACTIVE_HIGH> // col 5
            , <&ioex0 16 GPIO_ACTIVE_HIGH> // col 6
            , <&ioex0 6 GPIO_ACTIVE_HIGH> // col 7
            , <&ioex0 7 GPIO_ACTIVE_HIGH> // col 8
            , <&ioex0 8 GPIO_ACTIVE_HIGH> // col 9
            , <&ioex0 9 GPIO_ACTIVE_HIGH> // col 10
            , <&ioex0 1 GPIO_ACTIVE_HIGH> // col 11
            ;

        row-gpios
            = <&ioex1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 0
            , <&ioex1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 1
            , <&ioex1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 2
            , <&ioex1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 3
            , <&ioex1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 4
            ;
    };
};
